---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const all = await getCollection('challenges');
  return all.map((c) => ({ params: { id: c.id }, props: { c } }));
}
const { c } = Astro.props;
const d = c.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const embed = (id: string) => `https://www.youtube-nocookie.com/embed/${id}`;
---
<Layout title={`${d.title} – Dance Challenge Hub`} description={`${d.title} by ${d.artist}`}>
  <a href={`${base}/`} class="text-sm font-semibold text-pop">← All challenges</a>
  <h1 class="mt-2 font-display text-3xl font-extrabold sm:text-4xl">{d.title}</h1>
  <p class="text-ink/70">{d.artist} · {d.year}</p>

  <div id="tracker" data-id={c.id} class="mt-4 flex flex-wrap items-center gap-2">
    <button type="button" id="fav" class="chip" aria-pressed="false">♡ Favorite</button>
    <span class="mx-1 hidden h-6 w-px bg-ink/20 sm:block"></span>
    {[['none', 'Not started'], ['practicing', 'Practicing'], ['filmed', 'Filmed ✅']].map(([v, text]) => (
      <button type="button" data-status={v} class="chip" aria-pressed="false">{text}</button>
    ))}
  </div>

  <div class="mt-6 aspect-video overflow-hidden rounded-2xl border-2 border-ink shadow-[4px_4px_0_0_var(--color-ink)]">
    <iframe src={embed(d.youtubeId)} title={d.title} class="h-full w-full" loading="lazy" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>

  <dl class="mt-6 grid max-w-xl grid-cols-2 gap-3 text-sm">
    <div><dt class="font-semibold text-ink/60">Difficulty</dt><dd class="capitalize">{d.difficulty}</dd></div>
    <div><dt class="font-semibold text-ink/60">Dancers</dt><dd class="capitalize">{d.group}</dd></div>
    <div><dt class="font-semibold text-ink/60">Origin</dt><dd class="capitalize">{d.origin === 'kpop' ? 'K-pop' : d.origin}</dd></div>
    <div><dt class="font-semibold text-ink/60">Era</dt><dd>{d.era === 'past' ? 'Past hit' : 'Trending now'}</dd></div>
  </dl>

  {d.kidFriendly && <p class="mt-6 rounded-xl bg-mint/20 p-4"><strong>Kid check:</strong> {d.kidFriendly}</p>}
  {d.notes && <p class="mt-4 text-ink/80">{d.notes}</p>}

  {d.tutorialYoutubeId && (
    <section class="mt-8">
      <h2 class="font-display text-2xl font-bold">Step-by-step tutorial</h2>
      <div class="mt-3 aspect-video overflow-hidden rounded-2xl border-2 border-ink">
        <iframe src={embed(d.tutorialYoutubeId)} title={`${d.title} tutorial`} class="h-full w-full" loading="lazy" allowfullscreen></iframe>
      </div>
    </section>
  )}
</Layout>

<script>
  import { getEntry, setEntry, onChange } from '../../scripts/tracker';

  const root = document.getElementById('tracker')!;
  const id = root.dataset.id!;
  const fav = document.getElementById('fav')!;
  const statusBtns = root.querySelectorAll<HTMLButtonElement>('[data-status]');

  function render() {
    const e = getEntry(id);
    fav.setAttribute('aria-pressed', String(e.fav));
    fav.textContent = e.fav ? '♥ Favorited' : '♡ Favorite';
    statusBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.status === e.status)));
  }

  fav.addEventListener('click', () => setEntry(id, { fav: !getEntry(id).fav }));
  statusBtns.forEach((b) =>
    b.addEventListener('click', () => setEntry(id, { status: b.dataset.status as 'none' | 'practicing' | 'filmed' })),
  );
  onChange(render);
  render();
</script>
